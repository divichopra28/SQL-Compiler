
SQL> CREATE VIEW toppers AS SELECT name, cgpa, branch FROM students WHERE cgpa >= 8.5;
Query OK: view 'toppers' created.

SQL> CREATE VIEW cse_toppers AS SELECT name, cgpa FROM toppers WHERE branch = 'CSE';
Query OK: view 'cse_toppers' created.

