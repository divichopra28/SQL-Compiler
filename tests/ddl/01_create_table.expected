
SQL> CREATE TABLE departments (
         dept_id   INT PRIMARY KEY,
         dname     VARCHAR(30) NOT NULL UNIQUE,
         budget    DECIMAL(12,2) DEFAULT 100000,
         founded   DATE,
         active    BOOLEAN DEFAULT TRUE,
         CHECK (budget >= 0)
     );
Query OK: table 'departments' created (5 columns).

SQL> CREATE TABLE staff (
         sid      INT,
         dept_id  INT REFERENCES departments(dept_id),
         sname    VARCHAR(40) NOT NULL,
         code     CHAR(4),
         rating   DOUBLE,
         big      BIGINT,
         small    SMALLINT,
         notes    TEXT,
         login_at DATETIME,
         shift    TIME,
         PRIMARY KEY (sid),
         UNIQUE (sname, code)
     );
Query OK: table 'staff' created (10 columns).

SQL> CREATE TABLE IF NOT EXISTS staff (x INT);
Query OK: table 'staff' already exists, nothing done.

