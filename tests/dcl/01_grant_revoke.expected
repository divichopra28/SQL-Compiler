
SQL> CREATE USER user1;
Query OK: user 'user1' created (no privileges yet).

SQL> GRANT SELECT ON students TO user1;
Query OK: granted SELECT on 'students' to 'user1'.

SQL> GRANT SELECT, INSERT ON students TO user1;
Query OK: granted SELECT, INSERT on 'students' to 'user1'.

SQL> GRANT UPDATE ON students TO user1, user2;
Query OK: granted UPDATE on 'students' to 'user1'.
Query OK: granted UPDATE on 'students' to 'user2'.

SQL> GRANT ALL ON courses TO user2;
Query OK: granted ALL on 'courses' to 'user2'.

