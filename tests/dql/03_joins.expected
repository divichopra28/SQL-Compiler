SQL> SELECT s.name, f.name FROM students s CROSS JOIN faculty f WHERE s.id = 1;
+-------+-----------+
| name  | name      |
+-------+-----------+
| Rahul | Dr. Mehta |
| Rahul | Priya     |
| Rahul | Dr. Rao   |
+-------+-----------+
3 rows in set

SQL> SELECT a.name AS student, b.name AS classmate FROM students a JOIN students b ON a.branch = b.branch AND a.id < b.id;
+---------+-----------+
| student | classmate |
+---------+-----------+
| Rahul   | Priya     |
| Aarav   | Vikram    |
| Ananya  | Sneha     |
+---------+-----------+
3 rows in set

SQL> SELECT s.name, c.course_name FROM students s JOIN courses c ON s.id = c.student_id WHERE s.cgpa > 8.6 AND c.credits = 4;
+-------+-----------------+
| name  | course_name     |
+-------+-----------------+
| Priya | Compiler Design |
| Sneha | Signals         |
+-------+-----------------+
2 rows in set

SQL> SELECT s.name, COUNT(c.cid) AS courses FROM students s LEFT JOIN courses c ON s.id = c.student_id GROUP BY s.name ORDER BY courses DESC, s.name;
+--------+---------+
| name   | courses |
+--------+---------+
| Rahul  |       2 |
| Ananya |       1 |
| Priya  |       1 |
| Sneha  |       1 |
| Aarav  |       0 |
| Vikram |       0 |
+--------+---------+
6 rows in set

SQL> SELECT s.name, c.course_name FROM students s, courses c WHERE s.id = c.student_id AND s.branch = 'CSE';
