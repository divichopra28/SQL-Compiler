SQL> SELECT MIN(age), MAX(age), SUM(age), COUNT(email), COUNT(DISTINCT branch) FROM students;
+----------+----------+----------+--------------+------------------------+
| MIN(age) | MAX(age) | SUM(age) | COUNT(email) | COUNT(DISTINCT branch) |
+----------+----------+----------+--------------+------------------------+
|       18 |       22 |      120 |            4 |                      3 |
+----------+----------+----------+--------------+------------------------+
1 row in set

SQL> SELECT branch, COUNT(*) AS n, ROUND(AVG(cgpa), 2) AS avg_cgpa FROM students GROUP BY branch ORDER BY n DESC, branch;
+--------+---+----------+
| branch | n | avg_cgpa |
+--------+---+----------+
| CSE    | 2 |      8.8 |
| ECE    | 2 |     9.15 |
| IT     | 2 |      7.1 |
+--------+---+----------+
3 rows in set

SQL> SELECT name, cgpa FROM students ORDER BY cgpa DESC LIMIT 3;
