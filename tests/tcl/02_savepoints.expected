
SQL> START TRANSACTION;
Query OK: transaction 1 started (state: ACTIVE).

SQL> UPDATE students SET cgpa = 7.0 WHERE id = 1;
Query OK: 1 row updated in 'students'.

SQL> SAVEPOINT sp1;
Query OK: savepoint 'sp1' created in transaction 1.

SQL> UPDATE students SET cgpa = 9.0 WHERE id = 1;
Query OK: 1 row updated in 'students'.

SQL> SAVEPOINT sp2;
Query OK: savepoint 'sp2' created in transaction 1.

SQL> DELETE FROM courses WHERE cid = 106;
Query OK: 1 row deleted from 'courses'.

SQL> SHOW TRANSACTION;
Transaction ID    : 1
Transaction State : ACTIVE
Savepoints        : sp1 -> sp2
Pending Operations: 3
    1. UPDATE students  (1 row)
    -- SAVEPOINT sp1 --
    2. UPDATE students  (1 row)
    -- SAVEPOINT sp2 --
    3. DELETE FROM courses  (1 row)

SQL> ROLLBACK TO SAVEPOINT sp1;
Query OK: rolled back to savepoint 'sp1' - 2 operations undone, transaction 1 still ACTIVE.

SQL> SHOW TRANSACTION;
Transaction ID    : 1
Transaction State : ACTIVE
Savepoints        : sp1
Pending Operations: 1
    1. UPDATE students  (1 row)
    -- SAVEPOINT sp1 --

