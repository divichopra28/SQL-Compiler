
SQL> UPDATE students SET age = 21 WHERE id = 1;
Query OK: 1 row updated in 'students'.

SQL> UPDATE students SET age = 22, cgpa = 8.9 WHERE id = 3;
Query OK: 1 row updated in 'students'.

SQL> UPDATE students SET cgpa = cgpa + 0.1 WHERE branch = 'ECE';
Query OK: 2 rows updated in 'students'.

SQL> UPDATE students SET branch = 'AI' WHERE cgpa > (SELECT AVG(cgpa) FROM students) AND branch = 'CSE';
Query OK: 1 row updated in 'students'.

SQL> SELECT id, name, age, cgpa, branch FROM students ORDER BY id;
